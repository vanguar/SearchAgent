# SmartJob SearchAgent local configuration example.
# Copy to .env and fill only the optional integrations you want to smoke-test.

APP_NAME=SmartJob SearchAgent
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL remains the preferred target stack from the project rules.
# SQLite is a local-dev convenience fallback for deterministic acceptance.
DATABASE_URL=sqlite:///smartjob.local.sqlite3
# DATABASE_URL=postgresql+psycopg://smartjob:smartjob@localhost:5432/smartjob
DATABASE_CONNECT_TIMEOUT_SECONDS=2

SOURCE_ADAPTER_TIMEOUT_SECONDS=10

# BA is the primary source lane.
SOURCE_BA_ENABLED=true
SOURCE_BA_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service
SOURCE_BA_API_KEY=jobboerse-jobsuche

# Optional live source lanes. Keep disabled unless configured for smoke checks.
# Careerjet: публичный partner-эндпоинт (affid + обязательный Referer).
# v4 Publisher API авторизует по outbound IP publisher-аккаунта -> 403 с локальной машины.
# Affiliate id: https://www.careerjet.de/partners/
SOURCE_CAREERJET_ENABLED=false
SOURCE_CAREERJET_BASE_URL=http://public.api.careerjet.net/search
SOURCE_CAREERJET_API_KEY=
SOURCE_CAREERJET_REFERER=http://localhost:8000/
SOURCE_CAREERJET_FRAGMENT_SIZE=1000

SOURCE_EURES_ENABLED=false
SOURCE_EURES_BASE_URL=https://jobsearch.api.eures.europa.eu/datamodel/v2/JobSearch
SOURCE_EURES_API_KEY=

SOURCE_REMOTIVE_ENABLED=false
SOURCE_REMOTIVE_BASE_URL=https://remotive.com/api/remote-jobs

SOURCE_ADZUNA_ENABLED=false
SOURCE_ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs/de/search
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

SOURCE_JOOBLE_ENABLED=false
SOURCE_JOOBLE_BASE_URL=https://jooble.org/api
JOOBLE_API_KEY=

SOURCE_ARBEITNOW_ENABLED=true
SOURCE_ARBEITNOW_BASE_URL=https://www.arbeitnow.com/api/job-board-api

SOURCE_REMOTEJOBS_ENABLED=true
SOURCE_REMOTEJOBS_BASE_URL=https://remotejobs.org/api/v1/jobs

# Company ATS public APIs. Fill comma-separated company tokens/slugs to enable.
SOURCE_GREENHOUSE_ENABLED=true
SOURCE_GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io/v1/boards
SOURCE_GREENHOUSE_BOARD_TOKENS=

SOURCE_LEVER_ENABLED=true
SOURCE_LEVER_BASE_URL=https://api.lever.co/v0/postings
SOURCE_LEVER_COMPANY_SLUGS=

# API/RSS IT sources for expanded remote/CIS/Ukraine searches.
SOURCE_HH_ENABLED=true
SOURCE_HH_BASE_URL=https://api.hh.ru
SOURCE_HH_COUNTRY_NAMES=Kazakhstan,Kyrgyzstan,Uzbekistan,Georgia,Moldova

SOURCE_DOU_ENABLED=true
SOURCE_DOU_FEED_URL=https://jobs.dou.ua/vacancies/feeds/

SOURCE_DJINNI_ENABLED=true
SOURCE_DJINNI_FEED_URL=https://djinni.co/jobs/rss/

# Optional LLM convenience layer. Missing config must degrade to deterministic local behavior.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
LLM_TIMEOUT_SECONDS=45

# Optional Gmail scaffold/manual email workspace context.
GMAIL_ACCOUNT_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional Telegram digest.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SMTP digest.
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
